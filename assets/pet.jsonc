          "吃白饭", "大口吃零食", "吃早餐", "吃午餐", "吃晚餐",
          "吃冰淇淋融化", "吃糖葫芦", "吃西瓜", "涮火锅",
          "吃Token", "吃大闸蟹", "吃饺子", "吃腊八粥",
          "吃青团", "吃汤圆", "吃长寿面", "吃重阳糕"
        ]
      },
      {
        "id": "时节", "weight": 14, "actions": [
          "被落叶淹没", "堆雪人", "放烟花", "吃粽子", "吃年糕",
          "收红包", "写福字", "装点圣诞树", "萌化小幽灵",
