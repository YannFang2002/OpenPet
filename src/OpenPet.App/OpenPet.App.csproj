<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF and WinForms both define Application/MessageBox; keep usings explicit. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>OpenPet.App</RootNamespace>
    <AssemblyName>OpenPet</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>..\..\assets\icon\app.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Product>OpenPet</Product>
    <AssemblyTitle>OpenPet</AssemblyTitle>
    <Authors>OpenPet</Authors>
    <Description>A desktop pet that lives on the Thermalright 2.8" 320x240 USB screen.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="2.88.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenPet.Core\OpenPet.Core.csproj" />
    <ProjectReference Include="..\OpenPet.Devices\OpenPet.Devices.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\**\*">
      <Link>assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
